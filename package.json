{
  "name": "pg-event-bus",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "description": "PostgreSQL event bus",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": "Ilya Semenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/pg-event-bus.git"
  },
  "homepage": "https://github.com/IlyaSemenov/pg-event-bus#readme",
  "bugs": "https://github.com/IlyaSemenov/pg-event-bus/issues",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "lefthook install",
    "types": "tsc && tsc -p tests/tsconfig.json",
    "test": "bun test && bun run types",
    "prepublishOnly": "bun run build",
    "lint": "biome check --write ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.14",
    "publint": "^0.3.22",
    "ripple-di": "^1.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
